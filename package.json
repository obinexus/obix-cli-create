{
  "name": "obix-cli-create",
  "version": "0.5.0",
  "description": "OBIX Heart UX — scaffold an obix-template-node or obix-template-html project",
  "license": "MIT",
  "author": "OBINexus <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "obix-cli-create": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "templates",
    "test",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.15"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0"
  },
  "keywords": [
    "obix",
    "obinexus",
    "create",
    "scaffold",
    "template",
    "heart-ux",
    "data-oriented",
    "no-ghosting"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-cli-create.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-cli-create/issues"
  },
  "homepage": "https://github.com/obinexus/obix-cli-create#readme"
}
