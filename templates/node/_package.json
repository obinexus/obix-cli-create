{
  "name": "{{PROJECT_NAME}}",
  "version": "0.1.0",
  "description": "OBIX Heart UX — Node.js app (scaffolded by create-obix)",
  "main": "dist/server/app.js",
  "types": "dist/server/app.d.ts",
  "type": "module",
  "author": "{{AUTHOR}}",
  "license": "MIT",
  "scripts": {
    "build":        "tsc --project tsconfig.json && tsc --project tsconfig.ui.json",
    "build:server": "tsc --project tsconfig.json",
    "build:ui":     "tsc --project tsconfig.ui.json",
    "dev":          "node_modules/.bin/tsx watch src/server/app.ts",
    "start":        "node dist/server/app.js",
    "cli":          "node_modules/.bin/tsx src/cli/index.ts",
    "test":         "vitest run",
    "test:watch":   "vitest",
    "clean":        "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "chalk":     "^5.3.0",
    "commander": "^12.0.0",
    "cors":      "^2.8.5",
    "express":   "^4.18.3",
    "inquirer":  "^9.2.15",
    "table":     "^6.8.1",
    "uuid":      "^9.0.1"
  },
  "devDependencies": {
    "@types/cors":     "^2.8.17",
    "@types/express":  "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/node":     "^22.0.0",
    "@types/uuid":     "^9.0.7",
    "tsx":             "^4.7.0",
    "typescript":      "^5.3.3",
    "vitest":          "^1.2.1"
  },
  "bin": {
    "{{BIN_NAME}}": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
